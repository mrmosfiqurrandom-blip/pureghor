rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.admin == true
      );
    }
    
    function isSuperAdmin() {
      return request.auth != null && (
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superAdmin'
      );
    }
    
    // Settings: Public read, Admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Admins collection
    match /admins/{adminId} {
      allow read: if request.auth != null && (request.auth.uid == adminId || isAdmin());
      allow write: if isSuperAdmin();
    }
    
    // Categories: Public read active, Admin write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Products: Public read published, Admin write
    match /products/{productId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow write: if isAdmin();
    }
    
    // Banners: Public read active, Admin write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Offers: Public read active, Admin write
    match /offers/{offerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // FAQs: Public read, Admin write
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Reviews: Public read approved reviews, Authenticated or customer create, Admin full write
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin();
      allow create: if request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }
    
    // Coupons: Public read active for validation, Admin write
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Media metadata: Public read, Admin write
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Orders: Customer can create, read their own, Admin can read/write all
    match /orders/{orderId} {
      allow create: if true;
      allow read: if isAdmin() || (request.auth != null && resource.data.customerId == request.auth.uid) || request.query.limit <= 1;
      allow update, delete: if isAdmin();
    }
    
    // Customers: User read/write own, Admin read/write all
    match /customers/{customerId} {
      allow read, write: if request.auth != null && (request.auth.uid == customerId || isAdmin());
    }
    
    // Audit logs: Admin only
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
